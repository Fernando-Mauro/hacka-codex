# Copy to .env.local for local development.
#
# Base URL of the FieldLoop decision-engine backend (FastAPI, see ./backend).
# If unset, the frontend defaults to http://localhost:8000 and, if that is
# unreachable, falls back to its built-in client-side calculations.
#
# Local:       http://localhost:8000
# Production:  https://<your-backend-host>
NEXT_PUBLIC_API_BASE=http://localhost:8000
